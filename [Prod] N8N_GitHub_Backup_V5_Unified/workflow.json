    {
      "parameters": {
        "jsCode": "/* V5.0 SMART DIFF */\nconst local = $('1. Config & Scrub').item.json.scrubbed;\nconst remoteRaw = $input.first().json; \n\nlet remoteContent = null;\nlet sha = null;\nlet targetPath = $('1. Config & Scrub').item.json.targetPath;\n\nif (remoteRaw && remoteRaw.content) {\n   remoteContent = Buffer.from(remoteRaw.content, 'base64').toString('utf8');\n   sha = remoteRaw.sha;\n   if (remoteRaw.path) targetPath = remoteRaw.path; // Keep existing path (Identity Preservation)\n}\n\nconst localString = JSON.stringify(local, null, 2);\nconst remoteString = remoteContent ? JSON.stringify(JSON.parse(remoteContent), null, 2) : '';\n\nconst hasChanges = localString !== remoteString;\n\nreturn { json: {\n  hasChanges,\n  sha,\n  targetPath,\n  contentBase64: Buffer.from(localString).toString('base64'),\n  repoOwner: $('1. Config & Scrub').item.json.repoOwner,\n  repoName: $('1. Config & Scrub').item.json.repoName\n} };"
      },
