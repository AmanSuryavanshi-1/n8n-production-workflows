    {
      "parameters": {
        "jsCode": "/* V5.0 WORKER CONFIG */\nconst SENSITIVE_REGEX = /password|token|secret|api_?key|auth|bearer|credential|private_?key/i;\nconst REPO_OWNER = 'AmanSuryavanshi-1';\nconst REPO_NAME = 'n8n_Workflows';\n\nconst input = $input.first().json.body || $input.first().json; // Handle Webhook Body\nif (!input.name) return { json: { skipped: true } };\n\nfunction scrub(obj) {\n  if (typeof obj !== 'object' || obj === null) return obj;\n  if (Array.isArray(obj)) return obj.map(scrub);\n  const clean = {};\n  for (const [k, v] of Object.entries(obj)) {\n    if (SENSITIVE_REGEX.test(k)) clean[k] = '***REDACTED***';\n    else clean[k] = scrub(v);\n  }\n  return clean;\n}\nconst scrubbed = scrub(input);\n\nlet root = '_Unsorted';\nlet sub = '';\nif (input.tags) {\n  const pTag = input.tags.find(t => t.name.startsWith('Project:'));\n  if (pTag) root = pTag.name.replace('Project:', '').trim();\n  const sTag = input.tags.find(t => t.name.startsWith('Sub:'));\n  if (sTag) sub = sTag.name.replace('Sub:', '').trim() + '/';\n}\nconst safeName = input.name.replace(/[^a-zA-Z0-9-_]/g, '_');\nconst targetPath = `${root}/${sub}${safeName}/workflow.json`;\nconst readmePath = `${root}/${sub}${safeName}/README.md`;\n\nreturn { json: { \n  scrubbed, \n  targetPath, \n  readmePath,\n  repoOwner: REPO_OWNER, \n  repoName: REPO_NAME,\n  id: input.id\n} };"
      },
